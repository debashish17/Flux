# Environment (development/production)
ENVIRONMENT="development"

# Database Configuration (Supabase pooler URL)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"
# Optional: direct connection used by Prisma for migrations
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Google Gemini API
GEMINI_API_KEY="your-google-gemini-api-key-here"

# Supabase Auth
# Required: project URL (used to fetch JWKS for verifying RS256/ES256 tokens)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_JWT_AUDIENCE="authenticated"

# Optional / legacy: only set if your project still issues HS256 tokens
# (Project Settings -> API -> "JWT Secret"). Leave blank otherwise.
SUPABASE_JWT_SECRET=""

# CORS Configuration (production only - comma separated origins)
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"
